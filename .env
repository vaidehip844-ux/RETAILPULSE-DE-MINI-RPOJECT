# Database Configuration (PostgreSQL / SQLite auto-fallback)
DB_TYPE=auto
POSTGRES_USER=retailpulse
POSTGRES_PASSWORD=retailpulse123
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=retailpulse_db

# NoSQL Configuration (MongoDB / Local document store fallback)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=retailpulse_nosql

# Message Broker Configuration (RabbitMQ / Local Queue fallback)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_QUEUE=retail_sales_events
RABBITMQ_DLQ=retail_sales_events_dlq

# Webhook Security
WOOCOMMERCE_WEBHOOK_SECRET=whsec_retailpulse_secret_key_2026

# Server Ports
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
STREAMLIT_PORT=8501

# Delta Lake Storage
DELTA_LAKE_PATH=data/delta_tables/sales_delta

# Search Engine (Elasticsearch / Local Index fallback)
ELASTICSEARCH_HOST=http://localhost:9200
ELASTICSEARCH_INDEX=retailpulse_orders

ENVIRONMENT=development
LOG_LEVEL=INFO
